# ══════════════════════════════════════════════════════════════
# CRECE v2.0 — Environment Variables
# Copy to .env and update values for your environment
# ══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_DEBUG=true                       # Disable in production
APP_TITLE=CRECE v2.0
APP_VERSION=2.0.0

# ── Database (PostgreSQL 16 + PostGIS 3.4) ────────────────────
POSTGRES_USER=crece
POSTGRES_PASSWORD=crece_dev          # CHANGE in production
POSTGRES_DB=crece
DATABASE_URL=postgresql+asyncpg://crece:crece_dev@db:5432/crece
DATABASE_URL_SYNC=postgresql://crece:crece_dev@db:5432/crece

# ── Redis 7 ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=                      # Set in production

# ── MinIO (S3-compatible storage) ─────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin       # CHANGE in production
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=crece-files
MINIO_SECURE=false                   # true in production with TLS

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440              # 24 hours

# ── Claude AI ─────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-xxx            # Your Anthropic API key
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Celery (Background Tasks) ────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPLIBRE_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Flower (Celery Monitoring) ────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=flower_dev           # CHANGE in production

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json | text
