# =============================================================================
# CRECE v2.0 — Variables de entorno para Coolify
# Copiar estos valores en Coolify UI → Environment Variables
# NUNCA commitear valores reales
#
# Carlos: mismo patrón que ChatMX. Los secretos se generan con openssl.
# =============================================================================

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=crece
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=crece_production

# --- JWT Authentication ---
JWT_SECRET=                 # openssl rand -hex 64

# --- Claude AI (Content Factory, Planes IA) ---
CLAUDE_API_KEY=             # sk-ant-... de console.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- MinIO (S3 storage for photos, reports) ---
MINIO_ROOT_USER=crece-minio
MINIO_ROOT_PASSWORD=        # openssl rand -base64 32

# --- n8n Integration ---
N8N_WEBHOOK_SECRET=         # openssl rand -hex 32 (shared with n8n workflows)

# --- Social Media API Keys (optional, scrapers degrade gracefully) ---
# YOUTUBE_API_KEY=          # Google Cloud Console → YouTube Data API v3
# TIKTOK_MS_TOKEN=          # TikTok session token

# =============================================================================
# PASOS DE DEPLOY EN COOLIFY:
#
# 1. Coolify → New Project → "CRECE v2.0"
# 2. Add Resource → Docker Compose → GitHub → MarxCha/crece-v2
# 3. Select file: docker-compose.coolify.yml
# 4. Paste environment variables above (con valores reales)
# 5. Configure domains:
#    - Service "frontend": crece.mdconsultoria-ti.org → port 3000
#    - Service "backend":  api-crece.mdconsultoria-ti.org → port 8000
# 6. Enable SSL + Force HTTPS on both services
# 7. Deploy
#
# POST-DEPLOY:
# 8. In Coolify → Terminal del servicio "backend":
#    python scripts/seed.py
#    (Crea admin: admin@consultoriamd.com / crece2026!)
#
# 9. Create API key for n8n:
#    curl -X POST https://api-crece.mdconsultoria-ti.org/api/v1/api-keys \
#      -H "Authorization: Bearer <JWT_TOKEN>" \
#      -H "Content-Type: application/json" \
#      -d '{"name": "n8n production"}'
#    (Save the raw_key — shown only once)
#
# 10. Configure n8n credential:
#    - Credential type: CRECE API
#    - API URL: https://api-crece.mdconsultoria-ti.org/api/v1
#    - API Token: <raw_key from step 9>
# =============================================================================
