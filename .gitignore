.env.vercel
.env.vercel.pulled
.env.vercel.pulled.*
*.vercel.pulled
*.vercel.pulled.*

# ── Ephemeral session state ──────────────────────────────────
.context/HANDOFF

# ── Research artifacts transitorios (.context/) ───────────────
# Capturas y JSON crudos de sesiones de scraping/audit que NO son
# fuente canónica — los reportes consolidados sí van a docs.
.context/apify_*.json
.context/apify-*.json
.context/fb_pw*.png
.context/fb_pw*.json
.context/scraper_one_*.json
.context/screenshot-*.png
.context/juan-saymi-*.json
.context/saymi-batch-*.json
backend/.context/

# ── Backend local cache and state (gigabytes) ────────────────
backend/.cache/
backend/.local/

# ── Frontend env with rotating Cloudflare tunnel URLs ────────
frontend/.env.production

# ── PII / LFPDPPP (Ruta C — D-DATA-01) ────────────────────────
# Datos originales del CRECE Oracle APEX con PII de ~63K ciudadanos.
# NUNCA commitear. Gated por env var CRECE_MC_RAW_DIR.
backend/data/raw/mc_original/
# Deltas crudos de RADAR (posts+comments scraped, PII en comments) — NUNCA commitear.
backend/data/*_delta/
# Bundles/pilotos de RADAR + exports de análisis ad-hoc (contenido de redes / post IDs) — no versionar.
backend/data/saymi_pilot/
exports/
backend/.config/
backend/.pki/
backend/.wdm/
backend/data/models/*.pkl
backend/.env.scraping-keys

backend/data/raw/ine_cartografia/**/*.shp
backend/data/raw/ine_cartografia/**/*.dbf
backend/data/raw/ine_cartografia/**/*.shx
backend/data/raw/ine_cartografia/**/*.prj
backend/data/raw/ine_cartografia/**/*.cpg
backend/data/raw/ine_cartografia/**/*.zip

# Demoscopía CSVs (raw data, ingested via scripts/ingest_demoscopia_csvs.py)
backend/data/demoscopia_csvs/

# Test artifacts (Playwright screenshots, dev runtime)
frontend/test-results/

# SQLite WAL/SHM (runtime, regenerated on open)
*.db-shm
*.db-wal

# Portfolio MD-Consultoría (out of scope CRECE, prevent root drops)
/Portafolio_*.csv
/task_plan.md

# Plan IA reports (output runtime)
backend/data/reportes_plan_ia/

# Scratch outputs scrapers (testing — usar MinIO para archivar)
backend/scripts/data/

# Recovery 2026-05-22
backups/
.context/exports/
e2e/screenshots/
