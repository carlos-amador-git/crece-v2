# ══════════════════════════════════════════════════════════════
# CRECE v2.0 — Git Ignore
# ══════════════════════════════════════════════════════════════

# ── Environment Variables ─────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Node.js ───────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
.next/
out/
tsconfig.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ───────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
coverage/

# ── Playwright ────────────────────────────────────────────────
frontend/e2e/test-results/
frontend/e2e/screenshots/
playwright-report/
blob-report/

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Docker ────────────────────────────────────────────────────
docker/nginx/certs/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Database dumps ────────────────────────────────────────────
*.sql.gz
*.dump

# ── Temporary files ───────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Celery ────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── ML Models (downloaded at runtime) ─────────────────────────
*.bin
*.pt
*.onnx
/models/

# ── Scraper state (runtime) ──────────────────────────────────
*.db
!*.db.example
backend/vendor/
.vercel

# Graphify knowledge graph (local analysis)
graphify-out/

# ── Claude Code session artifacts ────────────────────────────
.claude/

# ── Local secrets (never track) ──────────────────────────────
.env.vercel

# ── Ephemeral session state ──────────────────────────────────
.context/HANDOFF

# ── Backend local cache and state (gigabytes) ────────────────
backend/.cache/
backend/.local/

# ── Frontend env with rotating Cloudflare tunnel URLs ────────
frontend/.env.production

# ── PII / LFPDPPP (Ruta C — D-DATA-01) ────────────────────────
# Datos originales del CRECE Oracle APEX con PII de ~63K ciudadanos.
# NUNCA commitear. Gated por env var CRECE_MC_RAW_DIR.
backend/data/raw/mc_original/
backend/.config/
backend/.pki/
backend/.wdm/
backend/data/models/*.pkl
