# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crece:crece_secret@localhost:5432/crece_v2
DATABASE_URL_SYNC=postgresql://crece:crece_secret@localhost:5432/crece_v2

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=CHANGE-ME-in-production-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── MinIO (S3-compatible) ─────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crece-v2
MINIO_SECURE=false

# ── Claude AI ─────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-CHANGE-ME
CLAUDE_MODEL=claude-sonnet-4-20250514
# Alias usado por algunos módulos; mismo valor que CLAUDE_API_KEY
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME

# ── Ollama / Gemma local (NLP Layer 2) ────────────────────
# IMPORTANTE: SIEMPRE vía endpoint Coolify VPS · NUNCA local Mac (consume RAM,
# detiene los 6-7 entornos de trabajo). Decisión persistida en memoria proyecto.
OLLAMA_BASE_URL=http://163.245.208.96:11434
OLLAMA_MODEL=gemma3:12b
# Tuning servidor remoto (afectan solo si se administra el VPS, NO cliente)
OLLAMA_NUM_PARALLEL=4
OLLAMA_KEEP_ALIVE=10m
OLLAMA_FLASH_ATTENTION=true
# Toggle proveedor IA: "claude" (default) | "ollama"
AI_PROVIDER=claude

# ── Scrapers · credenciales y keys ─────────────────────────
# Instagram via instaloader (cuenta dedicada para scraping, NO personal)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# ScrapeCreators (X/IG/TT bulk) · cuenta free al 2026-05-09 · sin método de pago
# Si se reactiva con cuenta de pago, NUNCA hardcodear default literal en código
SCRAPECREATORS_API_KEY=
# Chrome binary path para selenium/playwright headless en host (no Docker)
CHROME_BIN=/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
# Limit genérico para batch scraping/eval scripts (default 100)
LIMIT=100

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── App ───────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_TITLE=CRECE v2.0
APP_VERSION=2.0.0

# ── YouTube OAuth real (S2 PLAN-2026-05-13) ───────────────
# Gated por B-OAUTH-YT-GCP-1. CEO debe completar GCP setup:
#   1. Google Cloud Console → Project + YouTube Data API v3
#   2. OAuth consent screen (External · testing)
#   3. Credenciales OAuth 2.0 client → llenar las 2 vars siguientes
#   4. Authorized redirect: <REDIRECT_BASE>/oauth/callback/youtube
# Mientras OAUTH_YOUTUBE_ENABLED=false, el flow stub clásico responde.
OAUTH_YOUTUBE_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_BASE=http://localhost:8002/api/v1

# ── Observability (F0.1) ──────────────────────────────────
# Bugsink (self-hosted Sentry-compatible): opcional · empty = no-op
BUGSINK_DSN=
# Discord webhook para alertas 5xx/exception/429 sostenido · empty = no-op + warning startup
# Ver: .context/OBSERVABILITY-STATE-2026-04-23.md
DISCORD_WEBHOOK_URL=
