# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crece:crece_secret@localhost:5432/crece_v2
DATABASE_URL_SYNC=postgresql://crece:crece_secret@localhost:5432/crece_v2

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=CHANGE-ME-in-production-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── MinIO (S3-compatible) ─────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crece-v2
MINIO_SECURE=false

# ── Claude AI ─────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-CHANGE-ME
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── App ───────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_TITLE=CRECE v2.0
APP_VERSION=2.0.0
